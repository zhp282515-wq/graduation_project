# 当前默认启动链路需要：PostgreSQL、Milvus、DashScope、MinerU。
# 模型名称在 api/main.py 和 models/dashscope/ 中配置，未读取模型名称环境变量。
DASHSCOPE_API_KEY=
MINERU_API_KEY=
LANGGRAPH_POSTGRES_URI=postgresql://root:root@localhost:5432/graduation_project

# Milvus 默认值与本项目 Docker Compose 对应。
MILVUS_URI=http://localhost:19530
MILVUS_USER=root
MILVUS_PASSWORD=root

# 可选：覆盖 MinerU API 地址；留空使用代码默认值。
MINERU_BASE_URL=

# 可选工具：缺少 Firecrawl 密钥时不能正常联网检索。
# Firecrawl 地址目前在 agent/tools/websearch.py 固定，不读取 FIRECRAWL_BASE_URL。
FIRECRAWL_API_KEY=

# 仅手动切换为 OpenAIProvider 时使用，默认聊天链路不使用。
OPENAI_API_KEY=
