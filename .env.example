# 服务启动需要 PostgreSQL；聊天需要所选供应商的密钥，摘要与记忆需要 DashScope。
# 知识库初始化失败时普通聊天仍可启动，知识库接口返回 503；恢复后需重启服务。
# 聊天模型列表在 config/chat_models.json 配置；摘要、记忆、向量化和重排配置独立。
DASHSCOPE_API_KEY=
MINERU_API_KEY=
LANGGRAPH_POSTGRES_URI=postgresql://root:root@localhost:5432/graduation_project

# Milvus 默认值与本项目 Docker Compose 对应。
MILVUS_URI=http://localhost:19530
MILVUS_USER=root
MILVUS_PASSWORD=root

# 可选：覆盖 MinerU API 地址；留空使用代码默认值。
MINERU_BASE_URL=

# 可选工具：缺少 Firecrawl 密钥时不能正常联网检索。
# Firecrawl 地址目前在 agent/tools/websearch.py 固定，不读取 FIRECRAWL_BASE_URL。
FIRECRAWL_API_KEY=

# 使用 OpenAI 聊天模型时必需。
OPENAI_API_KEY=
# 可选：显式指定 OpenAI 兼容服务地址；留空使用 https://api.openai.com/v1。
OPENAI_BASE_URL=

# 默认聊天模型使用 DeepSeek；支持普通对话、思考和工具调用。
DEEPSEEK_API_KEY=

# 认证：生成至少32字节随机密钥，生产环境必须使用 HTTPS 与 Secure Cookie。
AUTH_JWT_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
