  "narrative": {
    "northStar": "明亮阅读室与黑色知识空间",
    "overview": "以白色为主的阅读空间和中性黑灰文字构成清晰的日常工作区，深灰标记操作与选择。公开入口将校徽融入品牌构图，以浅灰圆角叙事区和白色身份区形成层次；知识星图转入黑灰空间。简洁排版、细线与轻柔转场共同建立质感。",
    "keyCharacteristics": [
      "白色层次、中性黑灰正文与克制的深灰强调。",
      "中文宋体标题配无衬线正文，等宽字体服务编号和辅助信息。",
      "工作区使用明暗语义主题；暗色以黑灰为基础，星图保留独立空间。",
      "校徽、圆角、细线与色面界定结构，来源纸页和知识关系承担内容表达。"
    ],
    "rules": [
      {
        "name": "The Theme Boundary Rule",
        "body": "工作区使用随主题变化的语义变量；公开入口使用独立的 `--entry-*` 变量，不受工作区主题或星图强制夜色影响。",
        "section": "colors"
      },
      {
        "name": "The Content Depth Rule",
        "body": "纸页层叠表达来源，轨道和连线表达知识关系；普通容器保持清晰、克制。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 先复用现有语义变量、字体栈、细线和组件状态。",
      "Do 保留入口固定色与工作区明暗主题的边界。",
      "Do 用来源和知识关系决定视觉强调，并尊重减少动态效果。",
      "Do 在窄屏保持可读标签、键盘焦点和星图文字选择控件。"
    ],
    "donts": [
      "Don't 将入口局部深色星图、纸页旋转或首屏构图套用于所有业务页面。",
      "Don't 添加虚构统计、学校官方背书或把示例写成实时校园回答。",
      "Don't 用占位文字替代可见字段标签，或把知识空间描述成真实天体。"
    ]
  }
}
